{
  "version": 8,
  "id": "route-planner-alternatives",
  "name": "Route planner alternatives",
  "sources": {
    "routes": { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] } }
  },
  "layers": [
    {
      "id": "alternatives",
      "type": "line",
      "source": "routes",
      "filter": ["!=", ["get", "chosen"], true],
      "paint": {
        "line-color": [
          "match",
          ["get", "name"],
          "shortest",
          "#3182bd",
          "balanced",
          "#756bb1",
          "safest",
          "#31a354",
          "#636363"
        ],
        "line-width": 3,
        "line-dasharray": [2, 2],
        "line-opacity": 0.8
      }
    },
    {
      "id": "chosen",
      "type": "line",
      "source": "routes",
      "filter": ["==", ["get", "chosen"], true],
      "paint": { "line-color": "#08519c", "line-width": 5, "line-opacity": 0.6 }
    }
  ]
}
